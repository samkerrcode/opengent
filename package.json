{
  "name": "opengent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen:product": "node scripts/product.mjs",
    "dev": "npm run gen:product && vite",
    "build": "npm run gen:product && vite build",
    "preview": "vite preview",
    "check": "npm run gen:product && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "npm run gen:product && tauri dev --config src-tauri/tauri.product.conf.json",
    "tauri:build": "npm run gen:product && tauri build --config src-tauri/tauri.product.conf.json",
    "gen:types": "cargo test --workspace --lib export_bindings_ && node scripts/check-bindings.mjs",
    "verify": "npm run check && npm test && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
